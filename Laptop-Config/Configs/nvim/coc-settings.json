{
    "suggest.noselect": true,
    "suggest.enablePreview": false,
    "suggest.enablePreselect": false,
    "suggest.maxCompleteItemCount": 20,
    "suggest.autoTrigger": "always",
    "suggest.triggerAfterInsertEnter": false,
    "suggest.floatEnable": true,
    "suggest.detailMaxLength": 100,
    "suggest.snippetIndicator": "►",
    "suggest.minTriggerInputLength": 1,
    "suggest.acceptSuggestionOnCommitCharacter": true,
    "suggest.lowPrioritySourceLimit": 5,
    "suggest.highPrioritySourceLimit": 10,
    "suggest.removeDuplicateItems": true,
    "suggest.localityBonus": true,
    "suggest.labelMaxLength": 60,
    "suggest.timeout": 300,
    "suggest.triggerCompletionWait": 50,
    "suggest.formatItems": ["abbr", "kind", "menu"],

    "suggest.pumFloatConfig": {
        "border": true,
        "rounded": true,
        "shadow": false,
        "highlight": "CocFloating",
        "borderHighlight": "CocFloatingBorder"
    },

    "suggest.completionItemKindLabels": {
        "text":          "    󰉿",
        "method":        "    󰆧",
        "function":      "    󰊕",
        "constructor":   "     ",
        "field":         "    󰜢",
        "variable":      "    󰀫",
        "class":         "    󰠱",
        "interface":     "     ",
        "module":        "     ",
        "property":      "    󰜢",
        "unit":          "    󰑭",
        "value":         "    󰎠",
        "enum":          "    ",
        "keyword":       "    󰌋",
        "snippet":       "     ",
        "color":         "    󰏘",
        "file":          "    󰈚",
        "reference":     "    󰈇",
        "folder":        "    󰉋",
        "enumMember":    "     ",
        "constant":      "    󰏿",
        "struct":        "    󰙅",
        "event":         "     ",
        "operator":      "    󰆕",
        "typeParameter": "     ",
        "default":       "    󰟢"
    },

    "diagnostic.enable": true,
    "diagnostic.checkCurrentLine": true,
    "diagnostic.messageTarget": "float",
    "diagnostic.signOffset": 100,
    "diagnostic.errorSign": "✖",
    "diagnostic.warningSign": "⚠",
    "diagnostic.infoSign": "ℹ",
    "diagnostic.hintSign": "➤",
    "diagnostic.virtualText": true,
    "diagnostic.virtualTextCurrentLineOnly": false,
    "diagnostic.virtualTextPrefix": " | ● ",
    "diagnostic.virtualTextLines": 3,
    "diagnostic.virtualTextLineSeparator": " \\ ",
    "diagnostic.showDeprecated": true,
    "diagnostic.autoRefresh": true,
    "diagnostic.refreshOnInsertMode": false,
    "diagnostic.showUnused": false,

    "hover.autoHide": true,
    "hover.target": "float",
    "signature.target": "float",
    "signature.hideOnTextChange": true,

    "coc.preferences.extensionUpdateCheck": "daily",
    "coc.preferences.useQuickfixForLocations": true,
    "coc.preferences.formatOnSaveFiletypes": [],
    "workspace.ignoredFolders": ["$HOME/.cargo/**", "**/.git", "**/node_modules/**"],

    "list.autoResize": false,
    "list.maxHeight": 12,

    "coc.source.buffer.priority": 3,
    "coc.source.around.priority": 2,
    "coc.source.file.priority": 4,
    "coc.source.snippets.priority": 5,
    "coc.source.word.priority": 1,

    "java.enabled": true,
    "java.jdt.ls.java.home": "/usr/lib/jvm/java-25-openjdk/",
    "java.configuration.runtimes": [],
    "java.format.settings.profile": "custom",
    "java.format.settings.url": "",
    "java.format.enabled": true,

    "typescript.enabled": true,
    "typescript.format.tabSize": 4,
    "typescript.format.insertSpaceAfterCommaDelimiter": true,
    "typescript.format.insertSpaceAfterSemicolonInForStatements": true,
    "typescript.preferences.includePackageJsonAutoImports": "off",

    "javascript.enabled": true,
    "javascript.format.tabSize": 4,
    "javascript.format.insertSpaceAfterCommaDelimiter": true,
    "javascript.format.insertSpaceAfterSemicolonInForStatements": true,

    "html.enabled": true,
    "html.format.tabSize": 4,
    "html.format.wrapLineLength": 200,
    "html.format.indentInnerHtml": true,

    "css.enabled": true,
    "css.format.spaceAroundSelectorSeparator": true,
    "css.format.braceStyle": "expand",

    "json.enabled": true,
    "json.format.tabSize": 4,

    "yaml.enabled": true,
    "yaml.format.tabWidth": 4,

    "xml.enabled": true,

    "prettier.tabWidth": 4,
    "prettier.useTabs": false,
    "prettier.printWidth": 200,
    "prettier.semi": true,
    "prettier.singleQuote": false,
    "prettier.trailingComma": "es5",

    "snippets.ultisnips.pythonPrompt": false
}
