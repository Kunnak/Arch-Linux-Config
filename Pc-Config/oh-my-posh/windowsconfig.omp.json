{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
  {
    "type": "session",
    "style": "diamond",
    "background": "#504844",
    "foreground": "#decb9e",
    "leading_diamond": "\ue0b6",
    "powerline_symbol": "\ue0b0",
    "template": " {{ .UserName }} ",
    "trailing_diamond": "\ue0b0"
  },
  {
    "type": "path",
    "style": "powerline",
    "background": "#decb9e",
    "foreground": "#504844",
    "powerline_symbol": "\ue0b0",
    "properties": {
      "style": "folder"
    },
    "template": " {{ .Path }} "
  },
  {
    "type": "git",
    "style": "powerline",
    "background": "#5f87af",
    "foreground": "#ffffff",
    "powerline_symbol": "\ue0b0",
    "properties": {
      "branch_icon": "\ue725 ",
      "fetch_status": false
    },
    "template": " {{ .HEAD }} "
  },
  {
    "background": "#759d64",
    "background_templates": [
      "{{ if gt .Code 0 }}#ff0044{{ end }}"
    ],
    "foreground": "#ffffff",
    "leading_diamond": "<transparent,background>\ue0b0</>",
    "properties": {
      "always_enabled": true
    },
    "style": "diamond",
    "template": " \uf0e7 ",
    "trailing_diamond": "\ue0b4",
    "type": "status"
  }
],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}
