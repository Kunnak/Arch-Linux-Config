{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 10,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["wlr/taskbar"],
    "modules-right": [
        "custom/weather",
        "cpu",
        "temperature",
        "network",
        "pulseaudio",
        "pulseaudio#microphone",
        "clock",
        "clock#date",
        "custom/power"
    ],

    // Hyprland Workspaces
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize",
        "ignore-list": ["wlogout", "waybar"]
    },

    // Wetter-Modul
    "custom/weather": {
        "exec": "~/.config/waybar/weather.sh",
        "return-type": "json",
        "interval": 600,
        "format": "{}",
        "tooltip": true
    },

    // CPU Auslastung
    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": true,
        "on-click": "kitty btop"
    },

    // CPU Temperatur
    "temperature": {
        "thermal-zone": 0,
        "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
        "critical-threshold": 80,
        "format-critical": "󰸁 {temperatureC}°C",
        "format": "󰔏 {temperatureC}°C",
        "tooltip": true
    },

    // Netzwerk
    "network": {
        "interface": "wlan0",
        "format-wifi": "󰤨 {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "kitty nmtui"
    },

    // Uhrzeit (Haupt-Modul)
    "clock": {
        "timezone": "Europe/Berlin",
        "format": "󰥔 {:%H:%M}",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode"
        }
    },

    // Datum (Zweites Clock-Modul mit #date)
    "clock#date": {
        "timezone": "Europe/Berlin",
        "format": "󰃭 {:%d.%m.%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode"
        },
        "on-click": "~/.config/waybar/calender.sh"
    },

    // Audio Ausgabe (Lautsprecher)
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5"
    },

    // Mikrofon
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 Muted",
        "on-click": "pavucontrol",
        "on-click-right": "pamixer --default-source -t",
        "on-scroll-up": "pamixer --default-source -i 5",
        "on-scroll-down": "pamixer --default-source -d 5"
    },

    // Power Menü
    "custom/power": {
        "format": "󰐥",
        "on-click": "wlogout",
        "tooltip": false
    }
}
